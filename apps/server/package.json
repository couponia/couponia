{
  "name": "@couponia/api",
  "version": "0.0.0",
  "description": "Couponia server with Express, tRPC, REST, and GraphQL",
  "main": "main.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "mgAll": "prisma migrate dev --schema=prisma/admin.prisma",
    "genAll": "prisma generate && prisma generate --schema=prisma/admin.prisma",
    "beta": "standard-version -S --prerelease beta --tag-prefix=couponia@",
    "release": "standard-version -S --tag-prefix=couponia@"
  },
  "keywords": [],
  "author": "Mitch Chimwemwe Chanza <mitch.chichan@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@trpc/server": "^10.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "express-graphql": "^0.12.0",
    "graphql": "^16.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
